# Gere um segredo longo e aleatório para cada implantação.
SECRET_KEY=
APP_ENV=development

# Ative apenas para uma demonstração local isolada; o padrão é desativado.
ALLOW_GOOGLE_DEMO=false

# OAuth Google. Se não configurado, login Google fica desativado.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP necessário para envio do link temporário de redefinição de senha.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_FROM=
PUBLIC_BASE_URL=http://127.0.0.1:5000